---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection(
    "writing",
    ({ data }) => !data.externalUrl && (import.meta.env.DEV || !data.draft),
  );
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const dateLabel = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const tagLabel = entry.data.tags[0] ?? "Writing";
---

<Base
  title={`${entry.data.title} | Tara Manicsic`}
  description={entry.data.excerpt}
  bodyClass="post-page"
>
  <header class="post-hero">
    <div class="masthead">
      <span>New post</span>
      <span>{tagLabel}</span>
    </div>
    <div class="orn-rule"><span>&#10022;</span></div>

    <h1 class="post-title">{entry.data.title}</h1>
    <p class="excerpt">{entry.data.excerpt}</p>
    <span class="byline">Tara Manicsic &mdash; {dateLabel}</span>
  </header>

  <article class="section prose">
    <Content />
  </article>

  <div class="orn-rule outro"><span>&#10022;</span></div>

  <div class="section back-row">
    <a class="back-link" href="/writing/">More writing</a>
  </div>
</Base>

<style>
  .post-hero {
    padding: var(--space-3) var(--space-3) 0;
    max-width: 64rem;
    margin: 0 auto;
  }

  /* Running head, echoing the template's "NEW POST … #001" bar. */
  .masthead {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-family: var(--font-didone);
    font-size: 0.68rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--noir);
    padding-bottom: var(--space-2);
  }

  .post-title {
    font-family: var(--font-didone);
    font-weight: 400;
    text-transform: uppercase;
    text-align: center;
    /* The wide tracking is the signature of this layout — it needs the room,
       so the type scales down as the letter-spacing eats the line. */
    letter-spacing: 0.14em;
    font-size: clamp(1.9rem, 5.4vw, 4.2rem);
    line-height: 1.08;
    color: var(--noir);
    max-width: 14em;
    margin: var(--space-4) auto var(--space-3);
    /* balance the trailing letter-space so the centering reads true */
    text-indent: 0.14em;
  }

  .excerpt {
    font-family: var(--font-didone);
    font-style: italic;
    font-size: clamp(1rem, 1.9vw, 1.3rem);
    line-height: 1.5;
    text-align: center;
    color: var(--noir-soft);
    max-width: 32em;
    margin: 0 auto var(--space-3);
  }

  .byline {
    display: block;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--noir-soft);
    padding-bottom: var(--space-3);
  }

  /* Match the hero's rule inset so the two hairlines line up. */
  .orn-rule.outro {
    margin-top: var(--space-4);
    max-width: 64rem;
    padding-inline: var(--space-3);
  }

  .back-row {
    text-align: center;
    padding: var(--space-4) var(--space-3);
  }
  .back-link {
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--noir);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.4em;
  }
  .back-link:hover {
    color: var(--noir-soft);
  }

  @media (max-width: 760px) {
    .post-hero,
    .orn-rule.outro {
      padding-inline: var(--space-2);
    }
    .post-title {
      letter-spacing: 0.08em;
      text-indent: 0.08em;
      margin-top: var(--space-3);
    }
  }
</style>
