---
import Base from "../layouts/Base.astro";
import { REGISTERS, TOPIC_MAX } from "../lib/plaiy-core";
---

<Base
  title="Plaiy — Tara Manicsic"
  description="Pick a mode, pick a topic, get a live limerick, rap battle, or absurdist explainer about AI — generated on demand by Claude."
>
  <section class="section">
    <div class="section-head">
      <span class="eyebrow">Plaiy · a live-show demo</span>
      <h1 class="display">Pick a mode.<br />Pick a topic.</h1>
      <p class="lede">
        This is what my talks feel like: crowd picks the topic, and we make the
        concept stick with a bit. Powered by Claude, live, right now.
      </p>
    </div>

    <form id="plaiy-form" class="plaiy">
      <fieldset class="modes hair-grid red">
        <legend class="eyebrow">Mode</legend>
        <label class="mode">
          <input type="radio" name="mode" value="limerick" checked />
          <span class="cell-title">Limerick</span>
          <span class="meta">Explain it in five lines that rhyme</span>
        </label>
        <label class="mode">
          <input type="radio" name="mode" value="rapbattle" />
          <span class="cell-title">Rap battle</span>
          <span class="meta">Two sides, dueling verses</span>
        </label>
        <label class="mode">
          <input type="radio" name="mode" value="absurd" />
          <span class="cell-title">Absurd explainer</span>
          <span class="meta">Accurate, but ridiculous</span>
        </label>
      </fieldset>

      <div class="controls">
        <label class="field">
          <span class="eyebrow">Topic</span>
          <input
            id="topic"
            name="topic"
            type="text"
            maxlength={TOPIC_MAX}
            placeholder="e.g. AI hallucinations, the abundance framework, RAG"
            required
          />
        </label>

        <label class="field" id="register-field" hidden>
          <span class="eyebrow">Register</span>
          <select id="register" name="register">
            {REGISTERS.map((r) => <option value={r}>{r}</option>)}
          </select>
        </label>

        <button class="pill" type="submit" id="go">
          <span class="arrow">→</span><span id="go-label">Take the stage</span>
        </button>
      </div>
    </form>

    <div id="stage" class="stage" hidden>
      <span class="eyebrow" id="stage-label">The bit</span>
      <pre id="output"></pre>
      <button class="pill ghost" type="button" id="again">One more time</button>
    </div>

    <p id="error" class="error" role="alert" hidden></p>
  </section>
</Base>

<style>
  .lede {
    max-width: 32em; margin: var(--space-2) auto 0;
  }
  .plaiy { max-width: 68rem; margin: 0 auto; }
  .modes { padding: 0; margin: 0; }
  .modes legend {
    padding: 0 0 var(--space-2);
  }
  .mode { cursor: pointer; position: relative; }
  .mode input {
    position: absolute; inset: var(--space-2) auto auto var(--space-2);
    accent-color: var(--red);
  }
  .mode:has(input:checked) { background: color-mix(in srgb, var(--red) 12%, transparent); }
  .mode .cell-title { padding-left: 1.6em; }

  .controls {
    display: grid; grid-template-columns: 1fr auto auto;
    gap: var(--space-2); align-items: end;
    margin-top: var(--space-3);
  }
  .field { display: grid; gap: 0.4rem; }
  .field input, .field select {
    font: inherit; color: var(--ink);
    background: var(--paper);
    border: var(--rule-ink);
    padding: 0.8em 1em;
    min-width: 0;
  }
  .field input:focus, .field select:focus { outline: 3px solid var(--red); outline-offset: 2px; }

  .stage {
    max-width: 44rem;
    margin: var(--space-4) auto 0;
    background: var(--paper);
    border: var(--rule);
    padding: var(--space-3);
  }
  .stage pre {
    font-family: var(--font-display);
    font-size: 1.25rem; line-height: 1.5;
    white-space: pre-wrap; word-wrap: break-word;
    margin: var(--space-2) 0 var(--space-3);
  }
  .error {
    max-width: 44rem;
    margin: var(--space-3) auto 0;
    color: var(--red-deep);
    font-weight: 600;
    text-align: center;
  }
  .working #go-label::after {
    content: "…";
  }

  @media (max-width: 760px) {
    .controls { grid-template-columns: 1fr; align-items: stretch; }
  }
</style>

<script>
  const form = document.getElementById("plaiy-form") as HTMLFormElement;
  const topicInput = document.getElementById("topic") as HTMLInputElement;
  const registerField = document.getElementById("register-field") as HTMLElement;
  const registerSelect = document.getElementById("register") as unknown as HTMLSelectElement;
  const stage = document.getElementById("stage") as HTMLElement;
  const stageLabel = document.getElementById("stage-label") as HTMLElement;
  const output = document.getElementById("output") as HTMLPreElement;
  const errorEl = document.getElementById("error") as HTMLElement;
  const goButton = document.getElementById("go") as HTMLButtonElement;
  const goLabel = document.getElementById("go-label") as HTMLElement;
  const againButton = document.getElementById("again") as HTMLButtonElement;

  const MODE_LABELS: Record<string, string> = {
    limerick: "The limerick",
    rapbattle: "The battle",
    absurd: "The bit",
  };

  function currentMode(): string {
    const checked = form.querySelector<HTMLInputElement>('input[name="mode"]:checked');
    return checked?.value ?? "limerick";
  }

  function syncRegisterVisibility() {
    registerField.hidden = currentMode() !== "absurd";
  }
  form.addEventListener("change", syncRegisterVisibility);
  syncRegisterVisibility();

  let busy = false;

  async function perform() {
    if (busy) return;
    const mode = currentMode();
    const topic = topicInput.value.trim();
    if (!topic) {
      topicInput.focus();
      return;
    }

    busy = true;
    form.classList.add("working");
    goButton.disabled = true;
    goLabel.textContent = "Warming up the crowd";
    errorEl.hidden = true;

    try {
      const res = await fetch("/api/plaiy", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          mode,
          topic,
          register: mode === "absurd" ? registerSelect.value : undefined,
        }),
      });
      const data = (await res.json()) as { text?: string; error?: string };
      if (!res.ok || !data.text) {
        throw new Error(data.error ?? "Something went sideways. Try again?");
      }
      stageLabel.textContent = MODE_LABELS[mode] ?? "The bit";
      output.textContent = data.text;
      stage.hidden = false;
      stage.scrollIntoView({ behavior: "smooth", block: "nearest" });
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : "Something went sideways. Try again?";
      errorEl.hidden = false;
    } finally {
      busy = false;
      form.classList.remove("working");
      goButton.disabled = false;
      goLabel.textContent = "Take the stage";
    }
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    void perform();
  });
  againButton.addEventListener("click", () => void perform());
</script>
