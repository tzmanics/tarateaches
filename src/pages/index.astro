---
import { getCollection } from "astro:content";
import { Image, Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import heroPhoto from "../assets/tara-hero-full.jpg";
import { postHref, defaultMeta } from "../lib/content";
import { getWritingPosts } from "../lib/posts";
import talks from "../data/talks.json";

const studies = (await getCollection("caseStudies")).sort(
  (a, b) => a.data.order - b.data.order,
);

// Group into rows of up to two: consecutive non-paper slabs pair up in a
// work-pair row, consecutive paper slabs pair up in a full-bleed paper row.
type Study = (typeof studies)[number];
const kindOf = (s: Study) => (s.data.theme === "paper" ? "anchor" : "pair");
const rows: { kind: "pair" | "anchor"; items: Study[] }[] = [];
let pending: Study[] = [];
const flush = () => {
  if (pending.length) {
    rows.push({ kind: kindOf(pending[0]), items: pending });
    pending = [];
  }
};
for (const s of studies) {
  if (pending.length && kindOf(pending[0]) !== kindOf(s)) flush();
  pending.push(s);
  if (pending.length === 2) flush();
}
flush();

const posts = (await getWritingPosts()).slice(0, 6);
---

<Base
  title="Tara Manicsic | Content & Curriculum Leadership"
  description="I’m at my best turning technical complexity into something people actually want to learn."
  navStyle="over-hero"
>
  <header class="hero" slot="hero">
    <Nav style="over-hero" />
    <div class="duo t-bw">
      {
        /* Full-bleed cover crop is height-constrained, so smaller widths get
          upscaled and look grainy — always serve the full 1584px (the AVIF
          is still only ~35 KB); the win here is the modern formats. */
      }
      <Picture
        src={heroPhoto}
        alt="Tara Manicsic, smiling, on a rooftop with the city skyline behind her"
        formats={["avif", "webp"]}
        widths={[1584]}
        sizes="100vw"
        quality="high"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <aside class="hero-callout">
      <p class="callout-name">Tara Manicsic</p>
      <span class="eyebrow">Content &amp; Curriculum Leadership</span>
      <p>
        I believe in people. I lead with care, humor, and enough EQ to bring
        people along, not just push them forward. <strong
          >I&rsquo;m at my best turning technical complexity into something
          people actually want to learn.</strong
        >
      </p>
      <div class="cta-row">
        <a class="pill" href="#building"
          ><span class="arrow">→</span>See what I&rsquo;m building</a
        >
        <a class="pill ghost" href="/resume-tara-manicsic.pdf" download
          ><span class="arrow">→</span>Resume (PDF)</a
        >
      </div>
    </aside>
  </header>
  <hr />
  <section id="building" class="section">
    <div class="section-head">
      <span class="eyebrow">Building</span>
      <h2 class="display">
        Six things I built<br />&amp; what it took to build them
      </h2>
    </div>

    {
      rows.map((row) => (
        <div class={row.kind === "pair" ? "work-pair" : "paper-row"}>
          {row.items.map((s) => (
            <article class={`slab ${s.data.theme}`}>
              {s.data.image && (
                <div
                  class="slab-media"
                  style={`--focus: ${s.data.imagePosition ?? "50% 45%"}`}
                >
                  <Image
                    src={s.data.image}
                    alt=""
                    class:list={[{ "ui-shot": s.data.uiShot }]}
                    widths={[700, 1100]}
                    sizes="(max-width: 899px) 100vw, 50vw"
                  />
                </div>
              )}
              <div class="slab-body">
                <span class="eyebrow">Case study · {s.data.org}</span>
                <h3>
                  <a href={`/work/${s.id}/`}>{s.data.title}</a>
                </h3>
                <p class="dek">{s.data.dek}</p>
              </div>
            </article>
          ))}
        </div>
      ))
    }
  </section>
  <hr />
  <section id="writing" class="section">
    <div class="section-head">
      <span class="eyebrow">Writing</span>
      <h2 class="display">On teaching, teams<br />&amp; AI literacy</h2>
    </div>
    <div class="hair-grid ink">
      {
        posts.map((p) => (
          <article>
            <a href={postHref(p, p.id)}>
              <h3>{p.title}</h3>
            </a>
            <span class="meta">{p.meta ?? defaultMeta(p)}</span>
          </article>
        ))
      }
    </div>
  </section>

  <section id="speaking" class="section">
    <div class="section-head">
      <span class="eyebrow">Speaking</span>
      <h2 class="display">Talks &amp; workshops</h2>
    </div>
    <div class="hair-grid red">
      {
        talks.map((t) => (
          <article>
            <a href={t.url}>
              <h3>{t.title}</h3>
            </a>
            <span class="meta">
              {t.kind} · {t.venue}
            </span>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh; /* stable on iOS while the URL bar collapses */
    background: var(--ink);
  }
  .hero .duo {
    position: absolute;
    inset: 0;
  }
  .hero .duo img {
    transform: scale(1.18);
    object-position: 50% 32%;
  }

  .hero-callout {
    position: absolute;
    z-index: 5;
    right: var(--space-3);
    top: 10rem;
    max-width: 24rem;
    background: color-mix(in srgb, var(--ink) 74%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: var(--space-2);
    color: var(--paper);
  }
  .hero-callout .callout-name {
    font-size: 1.9rem;
    line-height: 1.1;
    margin-bottom: var(--space-2);
  }
  .hero-callout .eyebrow {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--mint);
  }
  .hero-callout .eyebrow::before {
    content: "";
    display: block;
    width: 3.5rem;
    height: 3px;
    background: var(--red);
    margin-bottom: var(--space-2);
  }
  .hero-callout p {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
    max-width: 22em;
  }
  .hero-callout p strong {
    font-weight: 400;
    font-style: italic;
    color: var(--mint);
  }
  .hero-callout .cta-row {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
  }

  /* ---------- case studies ---------- */
  .work-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    max-width: 74rem;
    margin: 0 auto;
  }
  @media (min-width: 900px) {
    .work-pair {
      padding-bottom: var(--askew);
    }
    .work-pair .slab:nth-child(2) {
      transform: translateY(var(--askew));
    }
  }

  .slab {
    padding: var(--space-4) var(--space-3);
  }
  .slab.red {
    background: var(--red);
    color: var(--mint);
  }
  .slab.ink {
    background: var(--ink);
    color: var(--mint);
  }
  .paper-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: var(--space-4) calc(-1 * var(--space-3)) 0;
    border-top: var(--rule);
    border-bottom: var(--rule);
    background: var(--paper);
  }
  .paper-row:has(.slab.paper:only-child) {
    grid-template-columns: 1fr;
  }
  .paper-row + .work-pair {
    margin-top: var(--space-4);
  }
  .slab.paper {
    background: var(--paper);
    color: var(--ink);
    padding: var(--space-5) var(--space-3);
  }
  .slab.paper + .slab.paper {
    border-left: var(--rule);
  }
  .slab .eyebrow {
    display: block;
    margin-bottom: var(--space-2);
    color: inherit;
    opacity: 0.75;
  }
  .slab.paper .eyebrow {
    color: var(--red);
    opacity: 1;
  }
  .slab h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 3.2vw, 3rem);
    line-height: 1.02;
    text-transform: uppercase;
  }
  .slab h3 a {
    color: inherit;
    text-decoration: none;
  }
  .slab h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }
  .slab.paper h3 {
    color: var(--red);
    font-size: clamp(1.9rem, 3.2vw, 3rem);
  }
  .slab .dek {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.35;
    margin-top: var(--space-2);
    max-width: 26em;
  }

  @media (max-width: 899px) {
    .work-pair {
      grid-template-columns: 1fr;
    }
    .paper-row {
      grid-template-columns: 1fr;
    }
    .slab.paper + .slab.paper {
      border-left: 0;
      border-top: var(--rule);
    }
  }
  /* Up through tablet-portrait the side-floated callout would sit on the
     photo's face, so pin it to the bottom instead (899px matches the
     work-pair stacking breakpoint). */
  @media (max-width: 899px) {
    .hero .duo img {
      transform: none;
    }
    /* Compact the callout so the face stays clear of it on small phones */
    .hero-callout {
      left: var(--space-2);
      right: var(--space-2);
      top: auto;
      bottom: var(--space-2);
      max-width: none;
    }
    .hero-callout .callout-name {
      font-size: 1.4rem;
      margin-bottom: var(--space-1);
    }
    .hero-callout .eyebrow,
    .hero-callout .eyebrow::before {
      margin-bottom: var(--space-1);
    }
    .hero-callout p {
      font-size: 1.05rem;
      line-height: 1.3;
      max-width: none; /* the box spans the hero here — use all of it */
    }
    .hero-callout .cta-row {
      margin-top: var(--space-2);
    }
    .hero-callout .pill {
      font-size: 0.8rem;
    }
  }
</style>
