---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import { sortByDateDesc, visiblePosts, postHref, defaultMeta } from "../lib/content";
import talks from "../data/talks.json";

const studies = (await getCollection("caseStudies")).sort(
  (a, b) => a.data.order - b.data.order,
);

// Group into rows of up to two: consecutive non-paper slabs pair up in a
// work-pair row, consecutive paper slabs pair up in a full-bleed paper row.
type Study = (typeof studies)[number];
const kindOf = (s: Study) => (s.data.theme === "paper" ? "anchor" : "pair");
const rows: { kind: "pair" | "anchor"; items: Study[] }[] = [];
let pending: Study[] = [];
const flush = () => {
  if (pending.length) {
    rows.push({ kind: kindOf(pending[0]), items: pending });
    pending = [];
  }
};
for (const s of studies) {
  if (pending.length && kindOf(pending[0]) !== kindOf(s)) flush();
  pending.push(s);
  if (pending.length === 2) flush();
}
flush();

const allPosts = await getCollection("writing");
const posts = sortByDateDesc(
  visiblePosts(
    allPosts.map((p) => ({ ...p.data, id: p.id })),
    import.meta.env.DEV,
  ),
).slice(0, 6);
---

<Base
  title="Tara Manicsic — Content & Curriculum Leadership"
  description="I build education that sticks and teams that ship. Case studies in curriculum, certification, team leadership, and community building."
  navStyle="over-hero"
>
  <header class="hero" slot="hero">
    <Nav style="over-hero" />
    <div class="duo t-bw">
      <img
        src="/images/tara-hero.jpg"
        alt="Tara Manicsic, smiling, outdoors"
        width="1100"
        height="1470"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <aside class="hero-callout">
      <p>Tara Manicsic</p>
      <span class="eyebrow">Content &amp; Curriculum Leadership</span>
      <p>
        I build education that sticks and teams that ship. I&rsquo;ve led through
        chaos — layoffs, remote transitions, competing priorities, tough
        tradeoffs. <strong>The result: better communication, better work, better outcomes.</strong>
      </p>
      <div class="cta-row">
        <a class="pill" href="#work"><span class="arrow">→</span>See the work</a>
        <a class="pill ghost" href="/resume-tara-manicsic.pdf" download><span class="arrow">→</span>Resume (PDF)</a>
      </div>
    </aside>
  </header>

  <div class="strip">
    <p>Education that sticks. Teams that ship.</p>
  </div>

  <section id="work" class="section">
    <div class="section-head">
      <span class="eyebrow">Featured work</span>
      <h2 class="display">Six things I built<br />&amp; what it took to build them</h2>
    </div>

    {
      rows.map((row) =>
        row.kind === "pair" ? (
          <div class="work-pair">
            {row.items.map((s) => (
              <article class={`slab ${s.data.theme}`}>
                <span class="eyebrow">Case study · {s.data.org}</span>
                <h3>
                  <a href={`/work/${s.id}/`}>{s.data.title}</a>
                </h3>
                <p class="dek">{s.data.dek}</p>
              </article>
            ))}
          </div>
        ) : (
          <div class="paper-row">
            {row.items.map((s) => (
              <article class="slab paper">
                <span class="eyebrow">Case study · {s.data.org}</span>
                <h3>
                  <a href={`/work/${s.id}/`}>{s.data.title}</a>
                </h3>
                <p class="dek">{s.data.dek}</p>
              </article>
            ))}
          </div>
        ),
      )
    }
  </section>

  <section id="writing" class="section">
    <div class="section-head">
      <span class="eyebrow">Writing</span>
      <h2 class="display">On teaching, teams<br />&amp; AI literacy</h2>
    </div>
    <div class="hair-grid ink">
      {
        posts.map((p) => (
          <article>
            <a href={postHref(p, p.id)}>
              <h3>{p.title}</h3>
            </a>
            <span class="meta">{p.meta ?? defaultMeta(p)}</span>
          </article>
        ))
      }
    </div>
  </section>

  <section id="speaking" class="section">
    <div class="section-head">
      <span class="eyebrow">Speaking</span>
      <h2 class="display">Talks &amp; workshops</h2>
    </div>
    <div class="hair-grid red">
      {
        talks.map((t) => (
          <article>
            <a href={t.url}>
              <h3>{t.title}</h3>
            </a>
            <span class="meta">{t.kind} · {t.venue}</span>
          </article>
        ))
      }
    </div>
  </section>

  <section id="approach" class="section approach">
    <div class="section-head">
      <span class="eyebrow">Approach</span>
      <h2 class="display">How I lead</h2>
    </div>
    <p>
      Good education is engineering: you find where understanding breaks, and
      you fix the failure point — <em>then you put it in production with real people.</em>
    </p>
    <p>
      Teams don&rsquo;t need less change. They need leaders who metabolize
      change into a plan people can actually follow.
    </p>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative; min-height: 100vh;
    display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    background: var(--ink);
  }
  .hero .duo { min-height: 100%; }
  .hero .duo img { object-position: 62% 18%; }

  .hero-callout {
    display: flex; flex-direction: column; justify-content: center;
    padding: calc(var(--space-4) + 3rem) var(--space-3) var(--space-4);
    color: var(--paper);
  }
  .hero-callout::before {
    content: ""; display: block;
    width: 3.5rem; height: 3px; background: var(--red);
    margin-bottom: var(--space-2);
  }
  .hero-callout .eyebrow { display: block; margin-bottom: var(--space-2); color: var(--mint); }
  .hero-callout p {
    font-family: var(--font-display);
    font-size: 1.45rem; line-height: 1.32;
    max-width: 22em;
  }
  .hero-callout p strong { font-weight: 400; font-style: italic; color: var(--mint); }
  .hero-callout .cta-row {
    display: flex; gap: var(--space-2); margin-top: var(--space-3);
    flex-wrap: wrap; align-items: center;
  }

  .hero-name {
    position: absolute; z-index: 4;
    left: var(--space-3); top: 4.5rem;
    font-size: 3em;
    white-space: nowrap;
  }

  /* ---------- case studies ---------- */
  .work-pair {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    max-width: 74rem; margin: 0 auto;
  }
  @media (min-width: 900px) {
    .work-pair { padding-bottom: var(--askew); }
    .work-pair .slab:nth-child(2) { transform: translateY(var(--askew)); }
  }

  .slab { padding: var(--space-4) var(--space-3); }
  .slab.red { background: var(--red); color: var(--mint); }
  .slab.ink { background: var(--ink); color: var(--mint); }
  .paper-row {
    display: grid; grid-template-columns: 1fr 1fr;
    margin: var(--space-4) calc(-1 * var(--space-3)) 0;
    border-top: var(--rule); border-bottom: var(--rule);
    background: var(--paper);
  }
  .paper-row:has(.slab.paper:only-child) { grid-template-columns: 1fr; }
  .paper-row + .work-pair { margin-top: var(--space-4); }
  .slab.paper {
    background: var(--paper); color: var(--ink);
    padding: var(--space-5) var(--space-3);
  }
  .slab.paper + .slab.paper { border-left: var(--rule); }
  .slab .eyebrow { display: block; margin-bottom: var(--space-2); color: inherit; opacity: 0.75; }
  .slab.paper .eyebrow { color: var(--red); opacity: 1; }
  .slab h3 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(1.9rem, 3.2vw, 3rem); line-height: 1.02;
    text-transform: uppercase;
  }
  .slab h3 a { color: inherit; text-decoration: none; }
  .slab h3 a:hover { text-decoration: underline; text-underline-offset: 0.12em; }
  .slab.paper h3 { color: var(--red); font-size: clamp(1.9rem, 3.2vw, 3rem); }
  .slab .dek {
    font-family: var(--font-display); font-style: italic;
    font-size: 1.25rem; line-height: 1.35;
    margin-top: var(--space-2); max-width: 26em;
  }

  /* ---------- approach ---------- */
  .approach { text-align: center; }
  .approach p {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    line-height: 1.32; max-width: 28em; margin: 0 auto;
  }
  .approach p + p { margin-top: var(--space-3); }
  .approach em { color: var(--red); }

  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .hero .duo { min-height: 62vh; }
    .hero-callout { padding: var(--space-4) var(--space-3); }
    .work-pair { grid-template-columns: 1fr; }
    .paper-row { grid-template-columns: 1fr; }
    .slab.paper + .slab.paper { border-left: 0; border-top: var(--rule); }
  }
  @media (max-width: 760px) {
    .hero-callout { padding: var(--space-3) var(--space-2); }
    .hero-name { left: var(--space-2); top: 4rem; font-size: 2rem; }
  }
</style>
