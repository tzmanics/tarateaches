---
interface Props {
  style?: "over-hero" | "on-page";
}
const { style = "on-page" } = Astro.props;
const path = Astro.url.pathname;
// Prefilled mailto so a first note arrives with the details I'd ask for anyway.
const contactSubject = "Hello from tarateaches.com";
const contactBody = [
  "Hi Tara,",
  "",
  "I'm ___ at ___, and I came across your site while looking for ___.",
  "",
  "What I have in mind:",
  "",
  "Timeline / next step:",
  "",
  "Thanks!",
  "",
].join("\n");
const contactHref =
  `mailto:tzmanics@gmail.com?subject=${encodeURIComponent(contactSubject)}` +
  `&body=${encodeURIComponent(contactBody)}`;

const links = [
  { href: "/#building", label: "Building" },
  { href: "/#writing", label: "Writing" },
  { href: "/#speaking", label: "Speaking" },
  { href: contactHref, label: "Contact Me" },
];
---

<nav class={`nav ${style}`} aria-label="Main">
  <a class="mark" href="/" aria-label="Tara Manicsic, home">
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M3 10.5 12 3l9 7.5"></path>
      <path d="M5 9.5V21h5v-6h4v6h5V9.5"></path>
    </svg>
  </a>
  <ul>
    {
      links.map((l) => (
        <li>
          <a href={l.href} aria-current={path === l.href ? "page" : undefined}>
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
